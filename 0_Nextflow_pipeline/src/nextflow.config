workDir="/path/to/nf/workdir/<projectname>" // path to nextflow work directory -> a new directory for every project, recommended to be run in the scratch directory if available


// tools
params.fastqc = "fastqc/0.11.9"
params.bbtools = "bbmap/39.01"
params.fastp = "fastp/0.23.2"
params.align = "bowtie2/2.5.1"
params.view = "samtools/1.16.1"
params.metaDMG = "metaDMG/0.37"
params.rtool = "r/4.2.2"
params.gzsort = "gz-sort/2023.4.13"
params.multiqc = "multiqc/1.21"

params{
  max_memory = 220.GB
  max_time = 48.h
}

process {
  // Cluster-specific SLURM settings
  // queue = '<partition>' // -> adjust to your HPC system
  // clusterOptions = '<options>' // -> adjust to your HPC system 
  // Original setup used for the publication:
  //clusterOptions = {task.time <= 30.min ? '--qos=30min' : task.time <= 12.h ? '--qos=12h' : '--qos=48h'}
  maxRetries = 2
  cache = 'lenient'
}

executor {
    name = 'slurm'
    queueSize = 500
    pollInterval = '15 sec'
    submitRateLimit = '100sec'
}

timeline {
  enabled = false
}

report {
  enabled = true
}